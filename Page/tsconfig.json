{
    "compilerOptions": {
        "strict": true,
        "outDir": "./build/",
        "noImplicitAny": true,
        "module": "es6",
        "target": "es5",
        "jsx": "react-jsx",
        "allowJs": true,
        "sourceMap": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "**/*",
        "components",
        "Application.tsx",
        "contexts",
        "constants",
        "index.tsx"
    ]
}